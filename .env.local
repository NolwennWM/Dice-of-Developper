# Default .env for the project, create a ".env" file and fill the following properties :

# host of the database
DB_HOST=changeMe
# Name of the database
DB_NAME=changeMe
# Username and Password for admin
DB_USER_ADMIN=changeMe
DB_PWD_ADMIN=changeMe
# Username and Password for guest
DB_USER_GUEST=changeMe
DB_PWD_GUEST=changeMe