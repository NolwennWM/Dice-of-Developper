# Default .env for the project, create a ".env" file and fill the following properties :

# host of the database
DB_HOST=changeMe
# name of the database
DB_NAME=changeMe
# admin user of the database
DB_USER_ADMIN=changeMe
# password of the admin user
MARIADB_ROOT_PASSWORD=changeMe
# normal user of the database
MARIADB_USER=changeMe
# password of the normal user
MARIADB_PASSWORD=changeMe
# root path of the project for the router
ROOT_PATH=changeMe
# IP whitelist for the admin panel
IP_WHITELIST=changeMe